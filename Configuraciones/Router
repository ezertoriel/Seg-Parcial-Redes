enable
configure terminal
hostname R-LAN
no ip domain-lookup
enable secret jimenez
username Ezequiel privilege 15 secret Cisco123
banner motd #Advertencia, Solo Personal Autorizado#
service password-encryption
ip domain-name ezequiel0863.itla.edu.do
ip ssh version 2
crypto key generate rsa modulus 2048

interface Gig0/0.10
encapsulation dot1q 10
ip address 10.8.63.1 255.255.255.0
description Conexion a VLAn 10
no shutdown
exit

interface Gig0/0.20
encapsulation dot1q 20
ip address 10.8.64.1 255.255.255.0
description Conexion a VLAN 20
no shutdown
exit

interface Gig0/0
no shutdown
duplex full
exit

ip dhcp excluded-address 10.8.63.1 10.8.63.10
ip dhcp pool VLAN-Servidores
default-router 10.8.63.1
network 10.8.63.0 255.255.255.0
dns-server 8.8.8.8
domain-name ezequiel.itla.edu.do
exit

ip dhcp excluded-address 10.8.64.1 10.8.64.10
ip dhcp pool VLAN-Usuarios
default-router 10.8.64.1
network 10.8.64.0 255.255.255.0
dns-server 8.8.8.8
domain-name ezequiel.itla.edu.do
exit


aaa new-model
radius server Ezequiel0863
address ipv4 10.8.63.10 auth-port 1812 acct-port 1813
key Jimenez23
exit
aaa group server radius NPS-G
server name Ezequiel0863
exit

aaa authentication login consola-auth group NPS-G local
aaa authentication login ssh-auth local
aaa authorization exec consola-authz group NPS-G local
aaa authorization exec ssh-authz local
aaa accounting exec default start-stop group NPS-G
aaa accounting system default start-stop group NPS-G
aaa authorization console 

privilege exec level 1 show
privilege exec level 1 show ip
privilege exec level 10 show running-config
privilege exec level 10 configure terminal
privilege exec level 10 ping


login on-success log
login on-failure log 
logging buffered 64000 informational
logging on 
service timestamps log datetime msec

line console 0
login authentication consola-auth
authorization exec consola-authz
logging synchronous
exit

line aux 0
login authentication consola-auth
authorization exec consola-authz
exit

line vty 0 4
transport input ssh
login authentication ssh-auth
authorization exec ssh-authz
exit

snmp-server community public ro
snmp-server location Zabbix

end
copy running-config startup-config
write


